# ESP32-WROVER-IE N16R8 board with an ADAU1701 used as the I2S clock master.

# Board support and clock topology.
CONFIG_BOARD_ESP32WROVER_ADAU1701=y
CONFIG_I2S_OUTPUT_ROLE_SLAVE=y
CONFIG_I2S_32BIT_OUTPUT=y

# ESP32-WROVER-IE N16R8: 16 MB QIO flash and 8 MB PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHMODE="qio"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

# Use the full 16 MB flash, including two 6 MB OTA slots.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="components/boards/partitions-16m.csv"
CONFIG_PARTITION_TABLE_FILENAME="components/boards/partitions-16m.csv"

# ADAU1701 is the I2S clock master at 44.1 kHz. Its EEPROM program must drive
# BCLK=64*fs from MP11 and LRCLK=fs from MP10. ESP32 transmits 16-bit PCM in
# 32-bit I2S slots as a slave.
CONFIG_OUTPUT_SAMPLE_RATE_44100=y
# The external ADAU1701 clock is stable, but Wi-Fi/PTP scheduling can
# occasionally delay the playback task. Keep enough margin to avoid
# discarding otherwise valid buffered and realtime ALAC frames. The realtime
# threshold also covers the complete 8 x 352-frame I2S DMA-ring interval.
CONFIG_AIRPLAY_TIMING_THRESHOLD_MS=60
CONFIG_AIRPLAY_RT_TIMING_THRESHOLD_MS=100
CONFIG_I2S_SCK_IO=-1
CONFIG_I2S_BCK_IO=14
CONFIG_I2S_WS_IO=27
CONFIG_I2S_DO_IO=26

# The schematic's logical I2C labels are crossed: physical ADAU1701 SDA is on
# ESP32 GPIO22 and physical SCL is on GPIO21.
CONFIG_DAC_I2C_SDA=22
CONFIG_DAC_I2C_SCL=21
CONFIG_DAC_PDN_GPIO=-1
CONFIG_DAC_PDN2_GPIO=-1
CONFIG_DAC_TAS57XX=n
CONFIG_DAC_TAS58XX=n
CONFIG_DAC_ES8311=n
CONFIG_DAC_ADAU1701=y
CONFIG_DAC_CONTROLS_VOLUME=n
# CONFIG_ADAU1701_VOLUME_PARAM_ADDR=0

# Unused optional peripherals.
CONFIG_SPDIF_DO_IO=-1
CONFIG_I2S_GND_IO=-1
CONFIG_I2S_VCC_IO=-1
CONFIG_LED_STATUS_GPIO=-1
CONFIG_LED_ERROR_GPIO=-1
CONFIG_LED_RGB_GPIO=-1
CONFIG_JACK_GPIO=-1
CONFIG_SPKFAULT_GPIO=-1
CONFIG_MUTE_GPIO=-1
CONFIG_DISPLAY_ENABLED=n

# ESP_GPIO_0 front-panel buttons. The inputs are active-low and use the
# ESP32's internal pull-ups, so each button connects its GPIO pin to pin 5
# (GND). Pin 1 (VCC) is not needed for passive buttons.
CONFIG_BTN_PLAY_PAUSE_GPIO=25
CONFIG_BTN_VOLUME_UP_GPIO=33
CONFIG_BTN_VOLUME_DOWN_GPIO=32

# AirPlay 2 does not expose a DACP remote session, so the play/pause button can
# only mute locally. Advertise classic AirPlay v1 for real source-side pause.
CONFIG_AIRPLAY_FORCE_V1=y
